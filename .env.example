# Template of the environment variables this project reads. Copy to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real keys. This file contains placeholders only.

# --- Data sources (optional today; EIA/FRED spot downloads work without keys) ---
OILFC_EIA_API_KEY=
OILFC_FRED_API_KEY=            # needed later for ALFRED real-time vintages

# --- LLM providers (used from milestone E2) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # only if you route some calls to another provider

# --- Local services (used from milestone E1, see compose.yaml) ---
DATABASE_URL=postgresql://oilfc:oilfc@localhost:5432/oilfc
REDIS_URL=redis://localhost:6379/0

# --- Behaviour ---
LOG_LEVEL=INFO
LLM_CACHE_DIR=.llm_cache
